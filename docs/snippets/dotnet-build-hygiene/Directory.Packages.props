<Project>
  <!-- Zentrale Paketverwaltung: Versionen stehen ausschließlich hier, Projektdateien referenzieren ohne Version. -->

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- Pinnt auch transitive Abhängigkeiten auf die hier genannten Versionen, z. B. für Sicherheitsupdates. -->
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
    <!-- Verbietet VersionOverride in Projektdateien. -->
    <CentralPackageVersionOverrideEnabled>false</CentralPackageVersionOverrideEnabled>
  </PropertyGroup>

  <ItemGroup Label="Analyzer für alle Projekte">
    <GlobalPackageReference Include="Meziantou.Analyzer" Version="3.0.140"
        IncludeAssets="Runtime;Build;Native;contentFiles;Analyzers" PrivateAssets="All" />
    <GlobalPackageReference Include="SonarAnalyzer.CSharp" Version="10.31.0.145097"
        IncludeAssets="Runtime;Build;Native;contentFiles;Analyzers" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup Label="Datenzugriff">
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.10" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.10" />
    <!-- Explizit gepinnt, weil der Npgsql-Provider transitiv eine ältere Relational-Version zieht. -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.10" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageVersion Include="EFCore.NamingConventions" Version="10.0.1" />
  </ItemGroup>

  <ItemGroup Label="WebApi">
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.10" />
  </ItemGroup>

  <ItemGroup Label="Tests">
    <PackageVersion Include="xunit.v3.mtp-v2" Version="3.2.2" />
    <PackageVersion Include="AwesomeAssertions" Version="9.5.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.10" />
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.13.0" />
    <!-- Transitiv über Testcontainers; 2025.1.0 enthält GHSA-mggc-4xg6-vcxf und GHSA-q939-rpr3-3284. -->
    <PackageVersion Include="SSH.NET" Version="2026.0.0" />
    <PackageVersion Include="TngTech.ArchUnitNET" Version="0.13.3" />
    <PackageVersion Include="TngTech.ArchUnitNET.xUnitV3" Version="0.13.3" />
  </ItemGroup>
</Project>
