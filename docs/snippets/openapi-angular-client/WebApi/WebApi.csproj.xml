<!-- Ausschnitt für <Name>.WebApi.csproj: erzeugt contracts/api.json bei jedem Build. -->
<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <OpenApiGenerateDocuments>true</OpenApiGenerateDocuments>
    <OpenApiGenerateDocumentsOnBuild>true</OpenApiGenerateDocumentsOnBuild>
    <!-- Pfad relativ zu diesem Projekt; contracts/ liegt im Repository-Root. -->
    <OpenApiDocumentsDirectory>$(MSBuildThisFileDirectory)../../../contracts</OpenApiDocumentsDirectory>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Microsoft.Extensions.ApiDescription.Server">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <!-- Die Bibliothek benennt die Datei nach dem Projekt; der Vertrag liegt fest unter contracts/api.json. -->
  <Target Name="RenameOpenApiDocumentToContractPath" AfterTargets="GetDocument;GenerateOpenApiDocuments;Build">
    <ItemGroup>
      <_GeneratedOpenApiDocument Include="$(OpenApiDocumentsDirectory)/$(MSBuildProjectName).json" Condition="Exists('$(OpenApiDocumentsDirectory)/$(MSBuildProjectName).json')" />
    </ItemGroup>
    <Move SourceFiles="@(_GeneratedOpenApiDocument)" DestinationFiles="$(OpenApiDocumentsDirectory)/api.json" Condition="'@(_GeneratedOpenApiDocument)' != ''" />
  </Target>

</Project>
